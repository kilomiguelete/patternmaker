{
  "name": "trendsplant-pattern-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generador de tablas de medidas, patrones y fichas tecnicas de prendas con preview en vivo",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:single": "vite build --config vite.config.single.ts"
  },
  "dependencies": {
    "jspdf": "2.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
